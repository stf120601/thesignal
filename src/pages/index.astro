---
import { Font } from 'astro:assets';
import SignalCard from '~/components/signal/SignalCard.astro';
import { signals, movements, performance, yieldPercent } from '~/data/signal-demo';
import '~/assets/styles/signal.css';
const navigation = [
  ['Home', '#home'],
  ['Signals', '#signals'],
  ['Results', '#results'],
  ['Methodology', '#methodology'],
  ['About', '#about'],
  ['Private', '#private'],
];
const format = (n: number) => `${n >= 0 ? '+' : ''}${n.toFixed(2)}`;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>
      The Signal — Sports Betting Intelligence
    </title><meta
      name="description"
      content="Read the market. Find the value. Independent sports betting analysis built on value, discipline and transparent results."
    /><meta name="theme-color" content="#05090c" /><meta
      property="og:title"
      content="The Signal — Sports Betting Intelligence"
    /><meta property="og:description" content="Read the market. Find the value." /><meta
      property="og:type"
      content="website"
    /><Font cssVariable="--font-inter" preload /></head
  >
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="signal-site" id="home">
      <header class="header wrap">
        <a class="wordmark" href="#home" aria-label="The Signal home">THE <strong>SIGNAL</strong></a><nav
          aria-label="Main navigation"
        >
          {navigation.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav><a class="header-cta" href="#private">Private access ↗</a>
      </header>
      <main id="main">
        <section class="hero">
          <div class="wrap hero-inner">
            <div class="hero-copy">
              <p class="eyebrow">Sports betting intelligence <span></span></p><h1>
                READ THE MARKET.<br />FIND THE <span>VALUE.</span>
              </h1><p class="intro">
                The Signal is an independent platform focused on data-driven sports betting analysis. We identify market
                inefficiencies, track key movements and share the best opportunities.
              </p><a class="button" href="#private">Explore the private <span aria-hidden="true">→</span></a>
            </div><div class="market-art" aria-hidden="true">
              <div class="orb"></div><div class="candles">
                {
                  [30, 50, 43, 67, 80, 95, 84, 110, 125].map((height, i) => (
                    <i style={`--height:${height}px;--rise:${i * 19}px`} />
                  ))
                }
              </div><p>BETTER ANALYSIS.<br />SMARTER DECISIONS.</p>
            </div>
          </div>
        </section>
        <div class="wrap content">
          <section id="signals">
            <div class="section-heading">
              <h2>Today's signals</h2><span class="demo-label">Demo dataset · Apr 2025</span><a href="#results"
                >View results →</a
              >
            </div><p class="demo-note">
              Preview data only. These are illustrative selections, not current betting recommendations.
            </p><div class="signal-grid">{signals.map((signal) => <SignalCard signal={signal} />)}</div>
          </section>
          <div class="analysis-grid">
            <section id="movements">
              <div class="section-heading">
                <h2>Market movements</h2><span class="rule"></span><span class="demo-label">Demo</span>
              </div><div class="table-scroll">
                <table>
                  <caption class="sr-only">Illustrative odds movements</caption><thead
                    ><tr
                      ><th scope="col">Team / event</th><th scope="col">Market</th><th scope="col">Odds movement</th><th
                        scope="col">Change</th
                      ></tr
                    ></thead
                  ><tbody
                    >{
                      movements.map((m) => (
                        <tr>
                          <>
                            <th scope="row">{m.event}</th>
                            <td>{m.market}</td>
                            <td>
                              {m.opening.toFixed(2)} <span class="arrow">→</span> {m.current.toFixed(2)}
                            </td>
                            <td class:list={[m.current / m.opening - 1 < 0 ? 'positive' : 'negative']}>
                              {m.current / m.opening - 1 < 0 ? '↓' : '↑'} {m.current / m.opening - 1 > 0 ? '+' : ''}
                              {((m.current / m.opening - 1) * 100).toFixed(1)}%
                            </td>
                          </>
                        </tr>
                      ))
                    }</tbody
                  >
                </table>
              </div>
            </section>
            <section class="performance" id="results">
              <h2>The Signal performance</h2><p class="label">Settled demo selections</p><div class="performance-body">
                <div class="ring"><strong>{format(yieldPercent)}%</strong><span>Yield</span></div><dl>
                  {
                    [
                      ['Picks', performance.picks],
                      ['Wins', performance.wins],
                      ['Losses', performance.losses],
                      ['Profit', `${format(performance.profit)}U`],
                      ['Staked', `${performance.stake.toFixed(1)}U`],
                    ].map(([label, value]) => (
                      <div>
                        <>
                          <dt>{label}</dt>
                          <dd>{value}</dd>
                        </>
                      </div>
                    ))
                  }
                </dl>
              </div><p class="performance-note">Transparent results. Including the losses.</p><p class="small-note">
                Yield = net profit / settled stake. Pending picks are excluded.
              </p>
            </section>
          </div>
          <section class="principles" id="methodology">
            {
              [
                ['◎', 'Value', 'We focus on the best odds, not the most popular picks.'],
                ['▥', 'Market movement', 'We track odds movement and market behaviour.'],
                ['◇', 'Discipline', 'Every selection comes with a stake and a risk management plan.'],
                ['◉', 'Transparency', 'All results are tracked, including the losses.'],
              ].map(([icon, title, text]) => (
                <article>
                  <>
                    <span aria-hidden="true">{icon}</span>
                    <div>
                      <>
                        <h3>{title}</h3>
                        <p>{text}</p>
                      </>
                    </div>
                  </>
                </article>
              ))
            }
          </section>
          <section class="about" id="about">
            <p class="eyebrow">Independent thinking. Measurable decisions.</p><p>
              The Signal looks beyond the headline odds. Our approach brings together market observation, probability
              and a consistent staking process.
            </p>
          </section>
          <section class="private" id="private">
            <div>
              <p class="eyebrow">The Signal Private</p><h2>A sharper view of the market.</h2><p>
                Deeper analysis. A disciplined process. Full transparency.
              </p>
            </div><div class="coming-soon">
              <span>Private access is coming soon</span><a class="button" href="#signals"
                >Explore the public preview →</a
              >
            </div>
          </section>
        </div>
      </main>
      <footer class="wrap footer">
        <a class="wordmark" href="#home">THE <strong>SIGNAL</strong></a><nav aria-label="Footer navigation">
          {navigation.map(([label, href]) => <a href={href}>{label}</a>)}
        </nav><p>© {new Date().getFullYear()} The Signal</p><p class="responsible">
          18+ · Bet responsibly. No outcome or return is guaranteed.
        </p>
      </footer>
    </div>
  </body>
</html>
